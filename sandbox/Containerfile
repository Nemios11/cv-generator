# Image of the agent sandbox (see docs/adr/0006-sandbox-agent.md).
# Toolchain of the project (Java 25, Node 22, git, gh) plus Claude Code.
# It contains no credentials: tokens are passed at run time by sandbox/agent.sh.
FROM docker.io/library/eclipse-temurin:25-jdk-noble AS jdk

FROM docker.io/library/node:22-bookworm-slim

ARG CLAUDE_CODE_VERSION=2.1.331
ARG GH_VERSION=2.105.0

ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:$PATH
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git jq less procps unzip \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI from the official release, verified against the published checksums.
RUN set -eu; cd /tmp; \
    f="gh_${GH_VERSION}_linux_amd64.tar.gz"; \
    curl -fsSLO "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${f}"; \
    curl -fsSLO "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_checksums.txt"; \
    grep " ${f}\$" "gh_${GH_VERSION}_checksums.txt" | sha256sum -c -; \
    tar -xzf "$f"; mv "gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh; \
    rm -rf /tmp/gh_*

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

# The workspace is a fresh clone (or, without GitHub, the host repository
# mounted read-only, with another owner); git clones and pushes over HTTPS with
# the short-lived GH_TOKEN through gh, never with stored credentials.
RUN git config --system safe.directory /workspace \
 && git config --system credential.https://github.com.helper '' \
 && git config --system --add credential.https://github.com.helper '!gh auth git-credential' \
 && mkdir -p /workspace && chmod 1777 /workspace

COPY maven-settings.xml /etc/sandbox/maven-settings.xml
COPY entry.sh selftest.sh /opt/sandbox/

# Every outbound connection goes through the egress proxy (network policy).
ENV HTTPS_PROXY=http://cv-sandbox-proxy:8888 \
    HTTP_PROXY=http://cv-sandbox-proxy:8888 \
    https_proxy=http://cv-sandbox-proxy:8888 \
    http_proxy=http://cv-sandbox-proxy:8888 \
    NO_PROXY=localhost,127.0.0.1 \
    no_proxy=localhost,127.0.0.1 \
    MAVEN_ARGS="-s /etc/sandbox/maven-settings.xml" \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    HOME=/home/agent \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    CV_SANDBOX=1

USER node
WORKDIR /workspace
ENTRYPOINT ["bash", "/opt/sandbox/entry.sh"]
CMD ["claude"]
