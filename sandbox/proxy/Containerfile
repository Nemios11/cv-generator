# Egress proxy of the agent sandbox: the only way out of the internal network.
# Default deny; only hosts listed in allowlist are reachable, only on port 443.
FROM docker.io/library/alpine:3.22

RUN apk add --no-cache tinyproxy=1.11.2-r0

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY allowlist /etc/tinyproxy/allowlist

USER tinyproxy
EXPOSE 8888
CMD ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
