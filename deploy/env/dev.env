# Environment "dev" (see deploy/README.md). No secrets here: passwords are
# generated by deploy/stack.sh outside the repository.
COMPOSE_PROJECT_NAME=cv-dev
CV_ENV=dev
# Entry point of the environment: http://localhost:8280
WEB_PORT=8280
# OpenAPI description and Swagger UI on the API.
API_DOCS_ENABLED=true
# Seconds to observe the environment after a release before "status" reports.
STATUS_WINDOW_SECONDS=300
