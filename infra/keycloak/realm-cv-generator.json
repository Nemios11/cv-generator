{
  "realm": "cv-generator",
  "displayName": "CV Generator",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "it",
    "en"
  ],
  "defaultLocale": "it",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "cv-frontend",
      "name": "CV Generator frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:4450/*",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html",
        "http://localhost:8280/*",
        "http://localhost:8380/*",
        "http://localhost:8480/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:4450",
        "http://localhost:8080",
        "http://localhost:8280",
        "http://localhost:8380",
        "http://localhost:8480"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:4450/*##http://localhost:8280/*##http://localhost:8380/*##http://localhost:8480/*"
      },
      "protocolMappers": [
        {
          "name": "audience-cv-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "cv-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cv-synthetic",
      "name": "Synthetic traffic of deployed environments",
      "description": "Service account used by the synthetic traffic generator (deploy/compose.yaml). The secret comes from the environment at import; the default is for local development only.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CV_SYNTHETIC_CLIENT_SECRET:synthetic-local-dev-only}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-cv-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "cv-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo-local-only-password",
          "temporary": false
        }
      ]
    }
  ]
}
